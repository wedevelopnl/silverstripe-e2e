{
    "name": "wedevelopnl/silverstripe-e2e",
    "description": "Helper module to run E2E tests against a Silverstripe website inside CI.",
    "type": "silverstripe-vendormodule",
    "license": "BSD-3-Clause",
    "keywords": [
        "silverstripe",
        "development",
        "e2e",
        "gitlab"
    ],
    "authors": [{
        "name": "WeDevelop",
        "email": "development@wedevelop.nl"
    }],
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6"
    },
    "require-dev": {
        "cambis/silverstan": "^2.1",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^11.3",
        "rregeer/phpunit-coverage-check": "^0.3",
        "silverstripe/htmleditor-tinymce": "^1.1",
        "tomasvotruba/type-coverage": "^2.0",
        "wernerkrauss/silverstripe-rector": "^1.0"
    },
    "suggest": {
        "silverstripe/htmleditor-tinymce": "Required only for the generate-tinymce-combined CI task; fixtures-only consumers do not need it (^1.1)."
    },
    "autoload": {
        "psr-4": {
            "WeDevelop\\E2e\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "WeDevelop\\E2e\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "composer/installers": false
        }
    },
    "extra": {
        "installer-name": "silverstripe-e2e",
        "branch-alias": {
            "dev-main": "1.x-dev"
        }
    }
}
